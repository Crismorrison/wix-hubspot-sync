PORT=3000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/wix_hubspot_sync

# HubSpot OAuth 2.0 Credentials
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback

# Wix Self-Hosted App Credentials
WIX_APP_ID=your_wix_app_id
WIX_APP_SECRET=your_wix_app_secret
WIX_REDIRECT_URI=http://localhost:3000/auth/wix/callback

# Optional Direct Wix Site API Key (for site-level testing)
# WIX_API_KEY=
# WIX_SITE_ID=
# WIX_ACCOUNT_ID=

